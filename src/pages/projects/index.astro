---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { priorityProjects } from "../../data/site";
---

<BaseLayout title="项目 | Rray" description="Rray 的 C++ 系统工程、分布式通信与 Agent 工程项目档案。" active="projects">
	<main id="main-content" class="page-shell">
		<header class="page-heading">
			<h1>项目</h1>
			<p>围绕分布式通信、缓存策略与 Agent 服务工程，保留三项优先项目说明。</p>
		</header>
		<div class="priority-project-list">
			{priorityProjects.map((project) => (
				<article class="project-feature">
					<div class="entry-meta"><span>{project.category}</span></div>
					<h2>{project.name}</h2>
					<p>{project.description}</p>
					<div class="entry-tags">{project.technologies.map((technology) => <span>{technology}</span>)}</div>
					<div class="project-links">
						<a href={project.path}>本站项目说明</a>
						<a href={project.repository} target="_blank" rel="noreferrer">GitHub 源码</a>
					</div>
				</article>
			))}
		</div>
		<p class="detail-content project-index-links">
			<a href="https://github.com/Rrrayy/algorithm-problems" target="_blank" rel="noreferrer">算法记录（175 题，Hot 100 完成 89 题）</a>
			<a href="https://github.com/Rrrayy?tab=repositories" target="_blank" rel="noreferrer">查看全部公开仓库</a>
		</p>
	</main>
</BaseLayout>
